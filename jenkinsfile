pipeline {
    agent any

    stages {

        stage('Clone') {
            steps {
                checkout scm
                echo 'Repository cloned successfully'
            }
        }

        stage('Build') {
            steps {
                bat 'echo Building Hyper Mall...'
            }
        }

        stage('Docker Build') {
            steps {
                bat 'docker build -t nikhilabba12/hyper-mall .'
            }
        }

        stage('Docker Login') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'USER',
                    passwordVariable: 'PASS'
                )]) {
                    bat '''
                    echo Logging into Docker...
                    docker logout
                    echo %PASS%> docker_pass.txt
                    type docker_pass.txt | docker login -u %USER% --password-stdin
                    del docker_pass.txt
                    '''
                }
            }
        }

        stage('Docker Push') {
            steps {
                bat 'docker push nikhilabba12/hyper-mall'
            }
        }

        stage('Docker Pull') {
            steps {
                bat 'docker pull nikhilabba12/hyper-mall'
            }
        }

        stage('Deploy (Run Container)') {
            steps {
                bat '''
                docker stop hyper-mall-container >nul 2>&1
                docker rm hyper-mall-container >nul 2>&1
                docker run -d -p 10000:10000 --name hyper-mall-container nikhilabba12/hyper-mall
                '''
            }
        }

        stage('Verify') {
            steps {
                bat 'docker ps'
            }
        }
    }
}