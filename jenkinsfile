pipeline {
    agent any

    stages {
        stage('Clone') {
            steps {
                git 'https://github.com/YOUR_USERNAME/hyper-mall.git'
            }
        }

        stage('Build') {
            steps {
                echo 'Build started...'
            }
        }
       stage('Live Logs') {
    steps {
        sh '''
        echo "Streaming logs..."
        echo "Build running..." >> logs.txt
        '''
    }
}
