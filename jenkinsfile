pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                bat 'echo Building...'
            }
        }

        stage('Docker Build') {
            steps {
                bat 'docker build -t nikhilabba12/hyper-mall .'
            }
        }

        stage('Docker Login') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'USER',
                    passwordVariable: 'PASS'
                )]) {
                    bat '''
                    echo %PASS%> pass.txt
                    type pass.txt | docker login -u %USER% --password-stdin
                    del pass.txt
                    '''
                }
            }
        }

        stage('Docker Push') {
            steps {
                bat 'docker push nikhilabba12/hyper-mall'
            }
        }

        // ✅ NEW
        stage('Docker Pull') {
            steps {
                bat 'docker pull nikhilabba12/hyper-mall'
            }
        }

        // ✅ NEW
        stage('Deploy (Run Container)') {
            steps {
                bat '''
                docker stop hyper-mall-container || exit 0
                docker rm hyper-mall-container || exit 0
                docker run -d -p 10000:10000 --name hyper-mall-container nikhilabba12/hyper-mall
                '''
            }
        }

        // ✅ NEW
        stage('Verify') {
            steps {
                bat 'docker ps'
            }
        }

        stage('Export Logs') {
            steps {
                bat '''
                echo Jenkins Build Started > frontend\\jenkins_logs.txt
                echo Build Success >> frontend\\jenkins_logs.txt
                '''
            }
        }

        stage('Build Report') {
            steps {
                bat '''
                echo { "status":"SUCCESS","time":"%DATE% %TIME%" } > frontend\\report.json
                '''
            }
        }

        // ⚠️ FIX THIS URL
        stage('Deploy Render') {
            steps {
                bat 'curl -X POST https://YOUR_REAL_RENDER_URL'
            }
        }
    }
}