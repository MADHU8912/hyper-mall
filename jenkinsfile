pipeline {
    agent any

    stages {

        stage('Clone') {
            steps {
                checkout scm
                echo 'Repository cloned successfully'
            }
        }

        stage('Build') {
            steps {
                bat 'echo Building Hyper Mall...'
            }
        }

        stage('Docker Build') {
            steps {
                bat 'docker build -t nikhilabba12/hyper-mall .'
            }
        }

        stage('Docker Login') {
    steps {
        withCredentials([string(
            credentialsId: 'dockerhub-creds',
            variable: 'PASS'
        )]) {
            bat '''
            echo Logging into Docker...
            echo %PASS% | docker login -u nikhilabba12 --password-stdin
            '''
        }
    }
}

        stage('Docker Push') {
            steps {
                bat 'docker push nikhilabba12/hyper-mall'
            }
        }

        stage('Docker Pull') {
            steps {
                bat 'docker pull nikhilabba12/hyper-mall'
            }
        }

        stage('Deploy (Run Container)') {
            steps {
                bat '''
                docker stop hyper-mall-container || exit 0
                docker rm hyper-mall-container || exit 0
                docker run -d -p 3000:3000 --name hyper-mall-container nikhilabba12/hyper-mall
                '''
            }
        }

        stage('Verify') {
            steps {
                bat 'docker ps'
            }
        }
    }
}