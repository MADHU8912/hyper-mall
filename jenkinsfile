pipeline {
    agent any

    stages {

        stage('Init Logs') {
            steps {
                bat 'echo Build started > frontend/logs.txt'
            }
        }

        stage('Build') {
            steps {
                bat 'echo Building project >> frontend/logs.txt'
            }
        }

        stage('Docker Build') {
            steps {
                bat 'docker build -t yourdockerhub/hyper-mall .'
            }
        }

        stage('Docker Login') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'USER',
                    passwordVariable: 'PASS'
                )]) {
                    bat 'echo %PASS% | docker login -u %USER% --password-stdin'
                }
            }
        }

        stage('Docker Push') {
            steps {
                bat 'docker push yourdockerhub/hyper-mall'
            }
        }

        stage('Report') {
            steps {
                bat '''
                echo { "status":"SUCCESS", "time":"%DATE% %TIME%" } > frontend/report.json
                '''
            }
        }
    }
}stage('Live Logs') {
    steps {
        bat '''
        echo Build started > frontend\\logs.txt
        timeout /t 2
        echo Step 1 complete >> frontend\\logs.txt
        timeout /t 2
        echo Step 2 complete >> frontend\\logs.txt
        '''
    }
}