pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                bat 'echo Building...'
            }
        }

        stage('Docker Build') {
            steps {
                bat 'docker build -t nikhilabba12/hyper-mall .'
            }
        }

        stage('Docker Login') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'USER',
                    passwordVariable: 'PASS'
                )]) {
                    bat '''
                    echo %PASS%> pass.txt
                    type pass.txt | docker login -u %USER% --password-stdin
                    del pass.txt
                    '''
                }
            }
        }

        stage('Docker Push') {
            steps {
                bat 'docker push nikhilabba12/hyper-mall'
            }
        }

        stage('Export Logs') {
            steps {
                bat '''
                echo Jenkins Build Started > frontend\\jenkins_logs.txt
                echo Build Success >> frontend\\jenkins_logs.txt
                '''
            }
        }

        stage('Build Report') {
            steps {
                bat '''
                echo { "status":"SUCCESS","time":"%DATE% %TIME%" } > frontend\\report.json
                '''
            }
        }

        stage('Deploy Render') {
            steps {
                bat 'curl -X POST https://your-render-deploy-hook'
            }
        }
    }
}